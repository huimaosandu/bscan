-- Advanced I/O Description

attribute AIO_COMPONENT_CONFORMANCE of XCAU15P_UBVA368 : entity is
        "STD_1149_6_2003";

attribute AIO_EXTEST_Pulse_Execution of XCAU15P_UBVA368 : entity is
        "Wait_Duration TCK 15";

attribute AIO_EXTEST_Train_Execution of XCAU15P_UBVA368 : entity is
        "train 30, maximum_time 120.0e-6";

attribute AIO_Pin_Behavior of XCAU15P_UBVA368 : entity is
"MGTHRXP0_224 : LP_time=22.5e-9 HP_time=45.0e-9; " &
"MGTHRXP0_225 : LP_time=22.5e-9 HP_time=45.0e-9; " &
"MGTHRXP1_224 : LP_time=22.5e-9 HP_time=45.0e-9; " &
"MGTHRXP1_225 : LP_time=22.5e-9 HP_time=45.0e-9; " &
