attribute AIO_COMPONENT_CONFORMANCE of XCZU64DR_FSVE1156 : entity is
        "STD_1149_6_2003";

attribute AIO_EXTEST_Pulse_Execution of XCZU64DR_FSVE1156 : entity is
        "Wait_Duration PS_JTAG_TCK 15";

attribute AIO_EXTEST_Train_Execution of XCZU64DR_FSVE1156 : entity is
        "train 30, maximum_time 120.0e-6";

