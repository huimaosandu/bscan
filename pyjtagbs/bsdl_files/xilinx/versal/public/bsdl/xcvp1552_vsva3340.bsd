        "HIGHZ_IO       (00101000101011)," & -- BYPASS reg
        "EXTEST_PULSE   (11110011110011)," & -- BOUNDARY reg
        "EXTEST_TRAIN   (11110111110111)," & -- BOUNDARY reg
