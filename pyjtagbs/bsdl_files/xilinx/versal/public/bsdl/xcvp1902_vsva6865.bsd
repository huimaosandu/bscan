attribute TAP_SCAN_MODE  of TMS : signal is true;
attribute TAP_SCAN_OUT   of TDO : signal is true;
attribute TAP_SCAN_CLOCK of TCK : signal is (40.0e6, BOTH);  

-- Compliance-Enable Description

attribute COMPLIANCE_PATTERNS of XCVP1902_VSVA6865 : entity is
        "(POR_B) (1)";

-- Instruction Register Description

attribute INSTRUCTION_LENGTH of XCVP1902_VSVA6865 : entity is 28;

attribute INSTRUCTION_OPCODE of XCVP1902_VSVA6865 : entity is
       "IDCODE         (0010010010010010010010011111)," & -- IDCODE, DEVICE_ID reg
        "BYPASS         (1111111111111111111111111111)," & -- BYPASS, BYPASS reg
        "EXTEST         (1001101001101001101001101111)," & -- BOUNDARY reg
        "SAMPLE         (0000010000010000010000011111)," & -- BOUNDARY reg
        "PRELOAD        (0000010000010000010000011111)," & -- BOUNDARY reg
	   "USERCODE       (0010000010000010000010001111)," & -- USER CODE, DEVICE_ID reg
        "HIGHZ_IO       (0010100010100010100010101111)," & -- BYPASS reg
        "EXTEST_PULSE   (1111001111001111001111001111)," & -- BOUNDARY reg
        "EXTEST_TRAIN   (1111011111011111011111011111)," & -- BOUNDARY reg
        "READ_DNA       (1100101100101100101100101111)," & -- DNA reg
        "USER1          (0000101110111110111110111111)," & -- PRIVATE, Not available until after configuration
        "USER2          (0000111110111110111110111111)," & -- PRIVATE, Not available until after configuration
        "USER3          (1000101110111110111110111111)," & -- PRIVATE, Not available until after configuration
        "USER4          (1000111110111110111110111111)" ; -- PRIVATE, Not available until after configuration

-- See the Versal ACAP Technical Reference Manual (AM011) at
-- https://www.xilinx.com/support/documentation/architecture-manuals/am011-versal-acap-trm.pdf
-- for descriptions of the instructions listed above and more.

attribute INSTRUCTION_CAPTURE of XCVP1902_VSVA6865 : entity is
        "XXXXXXXXXXXXXXXXXXXXXXXXXX01";

attribute INSTRUCTION_PRIVATE of XCVP1902_VSVA6865 : entity is
-- If the device is configured, and a USER instruction is implemented
-- and not private to the designer, then it should be removed
-- from INSTRUCTION_PRIVATE, and the target register should be defined
-- in REGISTER_ACCESS.
        "USER1," &
        "USER2," &
        "USER3," &
        "USER4"; 

-- Optional Register Description

attribute IDCODE_REGISTER of XCVP1902_VSVA6865 : entity is
	"XXXX" &	-- version
	"0100110001000000" &	-- base family
	"00001001001" &	-- manufacturer
	"1";		-- required by 1149.1


attribute USERCODE_REGISTER of XCVP1902_VSVA6865 : entity is
        "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX";


-- Register Access Description

attribute REGISTER_ACCESS of XCVP1902_VSVA6865 : entity is
--      "<reg_name>[<length>] (USER1)," &
--      "<reg_name>[<length>] (USER2)," &
--      "<reg_name>[<length>] (USER3)," &
--      "<reg_name>[<length>] (USER4)," &
        "DNA[516] (READ_DNA)," &  -- The 128-bit device DNA for 2D barcode lookup is DNA[MSB:MSB-127] 
        "BYPASS (HIGHZ_IO,BYPASS)," &
        "DEVICE_ID (USERCODE,IDCODE)," &
        "BOUNDARY (SAMPLE,PRELOAD,EXTEST,EXTEST_PULSE,EXTEST_TRAIN)";

